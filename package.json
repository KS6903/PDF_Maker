{
  "name": "pdf-maker",
  "version": "1.0.0",
  "description": "All-in-one offline PDF editor, maker and converter",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && node scripts/publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KS6903/PDF_Maker.git"
  },
  "keywords": [],
  "author": "KS6903",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "docx": "^9.7.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "lucide": "^1.47.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "productName": "PDF Maker",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ks6903.pdfmaker",
    "productName": "PDF Maker",
    "copyright": "Copyright © 2026 KS6903",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "PDF-Maker-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "PDF-Maker-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Maker"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KS6903",
        "repo": "PDF_Maker",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
